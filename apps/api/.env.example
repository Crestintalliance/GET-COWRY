# Copy to .env and fill in. Never commit .env.

NODE_ENV=development
PORT=4000
PUBLIC_WEB_URL=http://localhost:5173

# "mock" = fake eSIMs for development. "esimaccess" = real eSIMs (costs money from your balance).
SUPPLIER=mock
ESIMACCESS_BASE_URL=https://api.esimaccess.com/api/v1/open
ESIMACCESS_ACCESS_CODE=
ESIMACCESS_SECRET_KEY=

# Stripe test keys (sk_test_...). Leave empty to use the no-card dev checkout.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Postgres. Leave empty to keep orders in memory (lost on restart).
DATABASE_URL=

# Pricing rule: retail = max(wholesale + MIN_PROFIT, wholesale x MIN_MARKUP), rounded up to .99.
# Plans that keep less than $3 after card fees are hidden.
PRICE_MIN_PROFIT_USD=4
PRICE_MIN_MARKUP=1.25
